{
  "description": "Run the repository's delivery gates before an agent stops",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/stop.mjs\"",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
